# Required on Vercel. Use only the public publishable key (legacy anon also works).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY

# Comma-separated browser origins allowed to call Flask during development.
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional local Flask settings. Vercel ignores these.
HOST=127.0.0.1
PORT=5000

# Optional, setup-time only. A Supabase personal access token can run the bundled
# migration through the Management API. Never expose this value to the browser.
# SUPABASE_ACCESS_TOKEN=